{
    "name": "studioslot",
    "version": "0.0.0",
    "private": true,
    "packageManager": "npm@11.12.1",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "ng": "ng",
        "start:dev": "ng serve",
        "build:prod": "ng build",
        "watch:dev": "ng build --watch --configuration development",
        "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
        "test": "ng test",
        "test:run": "ng test --watch=false",
        "test:ci": "ng test --watch=false --coverage",
        "test:task": "node scripts/test-task.mjs",
        "lint:ts": "ng lint",
        "lint:ts:fix": "ng lint --fix",
        "lint": "npm run lint:ts",
        "format:check": "prettier --check .",
        "format:write": "prettier --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "@angular/common": "^22.2.4",
        "@angular/compiler": "^22.2.4",
        "@angular/core": "^22.2.4",
        "@angular/forms": "^22.2.4",
        "@angular/platform-browser": "^22.2.4",
        "@angular/router": "^22.2.4",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.2.4",
        "@angular/cli": "^22.2.2",
        "@angular/compiler-cli": "^22.2.4",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@vitest/coverage-v8": "^5.1.0",
        "angular-eslint": "22.6.0",
        "eslint": "^10.13.0",
        "husky": "^9.1.7",
        "jiti": "^2.6.1",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.2",
        "typescript-eslint": "8.72.1",
        "vitest": "^5.0.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "lmdb@3.5.6": true,
        "@parcel/watcher@2.6.0": true,
        "msgpackr-extract@3.0.7": true,
        "fsevents@2.3.3": true
    }
}
